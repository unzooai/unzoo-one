{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Unzoo One",
  "version": "0.1.0",
  "identifier": "ai.unzoo.one",
  "build": {
    "frontendDist": "../../../dist/client"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Unzoo One",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "payload/unterm.exe": "unterm.exe",
      "payload/unterm-cli.exe": "unterm-cli.exe",
      "payload/unterm-core.exe": "unterm-core.exe",
      "payload/conpty.dll": "conpty.dll",
      "payload/OpenConsole.exe": "OpenConsole.exe",
      "payload/libEGL.dll": "libEGL.dll",
      "payload/libGLESv2.dll": "libGLESv2.dll",
      "payload/mesa/opengl32.dll": "mesa/opengl32.dll",
      "payload/defaults/unterm.conf": "defaults/unterm.conf",
      "payload/assets/fonts/SymbolsNerdFontMono-Regular.ttf": "assets/fonts/SymbolsNerdFontMono-Regular.ttf",
      "payload/assets/fonts/NotoColorEmoji.ttf": "assets/fonts/NotoColorEmoji.ttf",
      "payload/assets/fonts/JetBrainsMono-Regular.ttf": "assets/fonts/JetBrainsMono-Regular.ttf",
      "payload/mcp-instructions.md": "mcp-instructions.md",
      "payload/unterm-product.txt": "unterm-product.txt",
      "payload/skills/unzoo-terminal/SKILL.md": "skills/unzoo-terminal/SKILL.md",
      "payload/skills/unzoo-browser/SKILL.md": "skills/unzoo-browser/SKILL.md",
      "payload/skills/unzoo-deliverables/SKILL.md": "skills/unzoo-deliverables/SKILL.md",
      "payload/skills/social-publish/SKILL.md": "skills/social-publish/SKILL.md",
      "payload/skills/content-repurpose/SKILL.md": "skills/content-repurpose/SKILL.md",
      "payload/skills/subtitle-and-clip/SKILL.md": "skills/subtitle-and-clip/SKILL.md",
      "payload/skills/short-video-pipeline/SKILL.md": "skills/short-video-pipeline/SKILL.md",
      "payload/skills/blog-to-platforms/SKILL.md": "skills/blog-to-platforms/SKILL.md",
      "payload/skills/content-calendar/SKILL.md": "skills/content-calendar/SKILL.md",
      "payload/skills/newsletter-digest/SKILL.md": "skills/newsletter-digest/SKILL.md"
    },
    "publisher": "Unzoo",
    "shortDescription": "Unzoo One — the AI task workspace",
    "longDescription": "Run, approve and track AI agent tasks on your own computer. Every tool call asks you first.",
    "windows": {
      "wix": {
        "language": [
          "en-US",
          "zh-CN"
        ]
      }
    }
  }
}
